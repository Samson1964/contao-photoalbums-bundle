<?php
/*
 * Kachel eines Albums als Listeneintrag.
 *
 * Anders als pa2_album baut dieses Template keine festen Zeilen, sondern eine
 * einzige Liste. Die Breite der Kacheln steuert das Stylesheet — brauchbar fuer
 * Gestaltungen, die von sich aus umbrechen sollen.
 *
 * @license LGPL-3.0-or-later
 */
?>
<?php if ($this->itemNumber == $this->firstItemInPageNumber): ?><ul><?php endif; ?>

<li class="album block<?php if ($this->class): ?> <?= $this->class ?><?php endif; ?>"<?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>
  <div class="albumInside">

    <?php if ($this->showTitle && $this->title): ?>
      <?php /* Siehe pa2_album: im Lightbox-Modus traegt nur ein sichtbares
             Element den Verweis, sonst erschiene das erste Foto doppelt. */ ?>
      <?php if ($this->albumLightbox && $this->addImage): ?>
        <h2><?= $this->title ?></h2>
      <?php else: ?>
        <h2><a href="<?= $this->href ?>" title="<?= $this->title ?>"<?php if ($this->albumLightbox): ?> data-lightbox="pa2_<?= $this->albumID ?>"<?php endif; ?>><?= $this->title ?></a></h2>
      <?php endif; ?>
    <?php endif; ?>

    <?php if ($this->addImage): ?>
      <figure class="image_container"<?php if ($this->margin): ?> style="<?= $this->margin ?>"<?php endif; ?>>
        <a href="<?= $this->href ?>" title="<?= $this->title ?>"<?php if ($this->albumLightbox): ?> data-lightbox="pa2_<?= $this->albumID ?>"<?php endif; ?>>
          <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>" loading="lazy">
        </a>
      </figure>
    <?php endif; ?>

    <?php if ($this->metaFields): ?>
      <div class="info">
        <?php foreach ($this->metaFields as $metaField): ?>
          <div class="<?= $metaField['key'] ?>"><?= $metaField['value'] ?></div>
        <?php endforeach; ?>
      </div>
    <?php endif; ?>

  </div>

  <?php if ($this->albumLightbox && $this->albumLightboxImages): ?>
    <div class="hide albumLightboxImages">
      <?php foreach ($this->albumLightboxImages as $lightboxImage): ?><?= $lightboxImage ?><?php endforeach; ?>
    </div>
  <?php endif; ?>
</li>

<?php if ($this->itemNumber == $this->lastItemInPageNumber): ?></ul><?php endif; ?>
