<?php
/*
 * Kachel eines Albums in der Alben-Uebersicht.
 *
 * Die Zeilenumbrueche steuert der Parser ueber rowStart und rowEnd; jede Zeile
 * bekommt eine eigene Umhuellung, damit sich Umbrueche sauber gestalten lassen.
 *
 * @license LGPL-3.0-or-later
 */
?>
<?php if ($this->rowStart): ?><div class="albumswrap <?= $this->rowClass ?>"><?php endif; ?>

<section class="album block<?php if ($this->class): ?> <?= $this->class ?><?php endif; ?>"<?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>
  <div class="albumInside">

    <?php if ($this->showTitle && $this->title): ?>
      <?php /* Im Lightbox-Modus darf nur EIN sichtbares Element den Verweis
             tragen, sonst stuende das erste Foto zweimal in der Bildergalerie.
             Gibt es ein Vorschaubild, uebernimmt dessen Verweis die Aufgabe und
             der Titel bleibt reiner Text; ohne Vorschaubild ist der Titel der
             einzige Anfasser. */ ?>
      <?php if ($this->albumLightbox && $this->addImage): ?>
        <h2><?= $this->title ?></h2>
      <?php else: ?>
        <h2><a href="<?= $this->href ?>" title="<?= $this->title ?>"<?php if ($this->albumLightbox): ?> data-lightbox="pa2_<?= $this->albumID ?>"<?php endif; ?>><?= $this->title ?></a></h2>
      <?php endif; ?>
    <?php endif; ?>

    <?php if ($this->addImage): ?>
      <figure class="image_container"<?php if ($this->margin): ?> style="<?= $this->margin ?>"<?php endif; ?>>
        <a href="<?= $this->href ?>" title="<?= $this->title ?>"<?php if ($this->albumLightbox): ?> data-lightbox="pa2_<?= $this->albumID ?>"<?php endif; ?>>
          <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>" loading="lazy">
        </a>
      </figure>
    <?php endif; ?>

    <?php if ($this->metaFields): ?>
      <div class="info">
        <?php foreach ($this->metaFields as $metaField): ?>
          <div class="<?= $metaField['key'] ?>"><?= $metaField['value'] ?></div>
        <?php endforeach; ?>
      </div>
    <?php endif; ?>

  </div>

  <?php if ($this->albumLightbox && $this->albumLightboxImages): ?>
    <div class="hide albumLightboxImages">
      <?php foreach ($this->albumLightboxImages as $lightboxImage): ?><?= $lightboxImage ?><?php endforeach; ?>
    </div>
  <?php endif; ?>
</section>

<?php if ($this->rowEnd): ?></div><?php endif; ?>
