<?php
/*
 * Versteckter Verweis auf ein Foto einer Lightbox-Gruppe.
 *
 * Wird in der Alben-Uebersicht gebraucht, wenn die Kachel beim Anklicken die
 * Lightbox mit allen Fotos des Albums oeffnen soll. Das Bild selbst ist ein
 * leeres Ein-Punkt-Bild als Datenadresse; geladen wird erst, was die Lightbox
 * anfordert.
 *
 * @license LGPL-3.0-or-later
 */
?>
<div class="hide" style="display:none!important;position:absolute!important;top:0!important;left:0!important;width:0!important;height:0!important;overflow:hidden!important">
  <a href="<?= $this->href ?>" title="<?= $this->title ?>" data-lightbox="pa2_<?= $this->albumID ?>">
    <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>">
  </a>
</div>
