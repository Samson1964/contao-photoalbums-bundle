<?php
/*
 * Kachel eines Fotos als Listeneintrag.
 *
 * Wie pa2_image, aber ohne feste Zeilen: Alle Fotos einer Seite stehen in
 * einer einzigen Liste, die Breite steuert das Stylesheet.
 *
 * @license LGPL-3.0-or-later
 */
?>
<?php if ($this->show): ?>

  <?php if ($this->itemNumber == $this->firstItemInPageNumber): ?><ul><?php endif; ?>

  <li class="image block<?php if ($this->isVideo): ?> video<?php endif; ?><?php if ($this->class): ?> <?= $this->class ?><?php endif; ?>">
    <?php if ($this->addImage): ?>
      <figure class="image_container"<?php if ($this->margin): ?> style="<?= $this->margin ?>"<?php endif; ?>>
        <?php if ($this->isVideo): ?>
          <a href="<?= $this->videoSrc ?>" title="<?= $this->title ?>" class="pa2-video" data-pa2-video="<?= $this->videoSrc ?>"<?php if ($this->videoType): ?> data-pa2-video-type="<?= $this->videoType ?>"<?php endif; ?>>
            <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>" loading="lazy">
          </a>
        <?php else: ?>
          <a href="<?= $this->href ?>" title="<?= $this->title ?>" data-lightbox="pa2_<?= $this->albumID ?>">
            <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>" loading="lazy">
          </a>
        <?php endif; ?>
      </figure>
    <?php endif; ?>
  </li>

  <?php if ($this->itemNumber == $this->lastItemInPageNumber): ?></ul><?php endif; ?>

<?php else: ?>

  <div class="hide" style="display:none!important;position:absolute!important;top:0!important;left:0!important;width:0!important;height:0!important;overflow:hidden!important">
    <a href="<?= $this->href ?>" title="<?= $this->title ?>" data-lightbox="pa2_<?= $this->albumID ?>">
      <img src="<?= $this->src ?>"<?= $this->imgSize ?> alt="<?= $this->alt ?>">
    </a>
  </div>

<?php endif; ?>
